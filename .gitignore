# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# macOS metadata
.DS_Store

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# Existing local meeting records and document drafts
/docs/meetings/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Generated output files
/output/
*.png
*.rds
*.csv
# Keep only the compact H8 source snapshot versioned.
/accessibility/output/*
!accessibility/output/h8_job_accessibility.csv

# Large reproducible inputs and intermediate routing files
accessibility/data/
data/
.positai

# Incremental targets workflow; preserve the configuration examples in Git.
/_targets/
/.R-library/
!config/*.csv
